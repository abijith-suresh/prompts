---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fontsBase = `${import.meta.env.BASE_URL}fonts/`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111111" />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={`${fontsBase}IBMPlexSansVar-Roman.woff2`} />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={`${fontsBase}IBMPlexMono-Regular.woff2`} />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
