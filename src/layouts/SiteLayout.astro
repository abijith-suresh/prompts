---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import { buildPromptPath } from "../lib/site-paths";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fontsBase = `${import.meta.env.BASE_URL}fonts/`;
const assetsBase = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#141414" />
    <link rel="icon" type="image/svg+xml" href={`${assetsBase}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${assetsBase}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${assetsBase}apple-touch-icon.png`} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      href={`${fontsBase}IBMPlexMono-Regular.woff2`}
    />

    <ClientRouter />

    <SEO title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">skip to content</a>

    <header class="site-topbar">
      <div class="topbar-inner">
        <a class="brand" href={import.meta.env.BASE_URL}>prompts</a>
        <nav class="topnav" aria-label="Primary">
          <a href={buildPromptPath(import.meta.env.BASE_URL, "all")}>all</a>
          <a href="https://abijith.sh" target="_blank" rel="noopener noreferrer">
            abijith.sh<span class="arrow-ext" aria-hidden="true">&nbsp;↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .site-topbar {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    align-items: center;
    padding-block: 1.5rem 0.25rem;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    width: min(100%, var(--container));
    margin-inline: auto;
    padding-inline: var(--page-inline);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .brand:hover {
    color: var(--color-text);
  }

  .topnav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .topnav a {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }

  .topnav a:hover {
    color: var(--color-text);
  }

  main {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    display: flex;
    flex-grow: 1;
    flex-direction: column;
  }
</style>
