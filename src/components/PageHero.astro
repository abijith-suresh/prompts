---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-header">
  {eyebrow && <p class="eyebrow" translate="no">{eyebrow}</p>}
  <h1>{title}</h1>
  <p class="page-description">{description}</p>

  <div style="margin-top:var(--space-m)">
    <slot name="actions" />
  </div>
</header>
