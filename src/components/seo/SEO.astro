---
import { SITE } from "@/consts";
import { buildCanonicalUrl } from "@/lib/site-paths";
import { getOgImagePath } from "@/lib/route-metadata";

export interface SEOProps {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalURL = buildCanonicalUrl(Astro.url.pathname);
const ogImage = new URL(getOgImagePath(Astro.url.pathname), `${SITE.url}/`).href;
const ogImageAlt = `${title} preview`;
---

<title>{title}</title>

<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="en-US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
