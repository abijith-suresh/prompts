---
interface Props {
  text: string;
  label?: string;
  ariaLabel?: string;
}

const { text, label, ariaLabel = "Copy prompt to clipboard" } = Astro.props;
---

<div>
  {label && <p class="eyebrow copy-text-label">{label}</p>}
  <div class="copy-text-block">
    <pre class="copy-text" translate="no"><code>{text}</code></pre>
    <button
      type="button"
      class="copy-button"
      aria-label={ariaLabel}
      data-copy-text={text}
    >
      <svg data-copy-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </svg>
      <svg class="hidden" data-check-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12" />
      </svg>
      <span data-copy-label>Copy prompt</span>
    </button>
    <span class="copy-status" data-copy-status aria-live="polite"></span>
  </div>
</div>

<script>
  async function copyText(text: string) {
    if (!navigator.clipboard) return false;

    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  document.addEventListener("click", async (event) => {
    const target =
      event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>("[data-copy-text]")
        : null;
    if (!target) return;

    const text = target.getAttribute("data-copy-text");
    if (!text) return;

    const copied = await copyText(text);
    const status = target.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
    const label = target.querySelector<HTMLElement>("[data-copy-label]");
    const copyIcon = target.querySelector<SVGElement>("[data-copy-icon]");
    const checkIcon = target.querySelector<SVGElement>("[data-check-icon]");

    if (!copied) {
      if (status) status.textContent = "Copy failed. Select the prompt text above to copy it.";
      return;
    }

    if (status) status.textContent = "Prompt copied.";
    if (label) label.textContent = "Copied";
    copyIcon?.classList.add("hidden");
    checkIcon?.classList.remove("hidden");

    window.clearTimeout(Number(target.dataset.copyTimeout ?? "0"));
    target.dataset.copyTimeout = String(
      window.setTimeout(() => {
        if (label) label.textContent = "Copy prompt";
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
      }, 1600)
    );
  });
</script>
