---
import Container from "@/components/ui/Container.astro";
import { buildRepositoryUrl } from "@/lib/prompt-catalog";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <Container>
      <div class="footer-row">
        <p>&copy; {currentYear} abijith suresh</p>
        <nav class="footer-links" aria-label="Site links">
          <a href={buildRepositoryUrl()} class="footer-link" target="_blank" rel="noopener noreferrer">
            github <span class="ext-arrow" aria-hidden="true">&nearr;</span>
          </a>
          <a href="https://abijith.sh" class="footer-link" target="_blank" rel="noopener noreferrer">
            abijith.sh <span class="ext-arrow" aria-hidden="true">&nearr;</span>
          </a>
        </nav>
      </div>
    </Container>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    position: relative;
    z-index: var(--z-content);
    width: 100%;
  }

  .footer-inner {
    padding-block: 1.5rem 3rem;
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
  }

  .footer-row p {
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-wrap);
  }

  .footer-link {
    color: var(--color-muted-foreground);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer-link:hover {
    color: var(--color-text);
  }

  .ext-arrow {
    display: inline-block;
    transition: transform var(--transition-lift);
  }

  a:hover .ext-arrow {
    transform: translate(2px, -2px);
  }

  @media print {
    .site-footer {
      border-color: #ccc;
    }
  }
</style>
