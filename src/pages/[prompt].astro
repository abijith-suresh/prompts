---
import { getCollection, getEntry, render } from "astro:content";

import CopyTextBlock from "../components/CopyTextBlock.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  buildPromptSourceUrl,
  PROMPTS_REPOSITORY,
} from "../lib/prompt-catalog";
import { extractPromptBody } from "../lib/extract-prompt-body";

export async function getStaticPaths() {
  const definitions = await getCollection("promptDefinitions");
  return definitions.map((definition) => ({
    params: { prompt: definition.id },
  }));
}

const slug = Astro.params.prompt;
if (!slug) {
  throw new Error("Prompt route parameter is required");
}

const definition = await getEntry("promptDefinitions", slug);
if (!definition) {
  throw new Error(`Prompt definition not found: ${slug}`);
}

const promptBody = definition.body ? extractPromptBody(definition.body) : null;
const { Content } = await render(definition);
---

<SiteLayout title={`${definition.data.name} | Prompts`} description={definition.data.description}>
  <article class="page-shell">
    <nav class="breadcrumb eyebrow rise" style="--d: 0ms" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL}>Prompts</a>
      <span aria-hidden="true">/</span>
      <span translate="no">{definition.data.name}</span>
    </nav>

    <h1 class="rise" style="--d: 80ms" translate="no">{definition.data.name}</h1>
    <a
      class="text-link rise"
      style="--d: 160ms"
      href={buildPromptSourceUrl(PROMPTS_REPOSITORY, definition.id)}
      target="_blank"
      rel="noopener noreferrer"
    >
      View source on GitHub<span class="arrow-ext" aria-hidden="true">&nbsp;↗</span>
    </a>

    <section class="detail-section rise" style="--d: 240ms" aria-labelledby="prompt-description-title">
      <div class="section-header">
        <h2 id="prompt-description-title" class="eyebrow">Description</h2>
      </div>
      <p class="page-description">{definition.data.description}</p>
    </section>

    {promptBody && (
      <section
        class="detail-section rise"
        style="--d: 320ms"
        aria-labelledby="copy-prompt-title"
      >
        <div class="section-header">
          <h2 id="copy-prompt-title" class="eyebrow">Copy prompt</h2>
        </div>
        <p class="page-description">Paste this into an AI chat application or coding agent.</p>
        <CopyTextBlock
          text={promptBody}
          ariaLabel={`Copy ${definition.data.name} prompt to clipboard`}
        />
      </section>
    )}

    <section
      class="detail-section rise"
      style={promptBody ? "--d: 400ms" : "--d: 320ms"}
      aria-labelledby="prompt-content-title"
    >
      <div class="section-header">
        <h2 id="prompt-content-title" class="eyebrow">PROMPT.md</h2>
      </div>
      <div class="prose">
        <Content />
      </div>
    </section>
  </article>
</SiteLayout>
