---
import { getCollection, getEntry, render } from "astro:content";

import CopyPromptButton from "../components/CopyPromptButton.astro";
import { buildPageTitle } from "../consts";
import SiteLayout from "../layouts/SiteLayout.astro";
import { buildPromptSourceUrl, PROMPTS_REPOSITORY } from "../lib/prompt-catalog";
import { extractPromptBody } from "../lib/extract-prompt-body";

export async function getStaticPaths() {
  const definitions = await getCollection("promptDefinitions");
  return definitions.map((definition) => ({
    params: { prompt: definition.id },
  }));
}

const slug = Astro.params.prompt;
if (!slug) {
  throw new Error("Prompt route parameter is required");
}

const definition = await getEntry("promptDefinitions", slug);
if (!definition) {
  throw new Error(`Prompt definition not found: ${slug}`);
}

const promptBody = definition.body ? extractPromptBody(definition.body) : null;
const { Content } = await render(definition);
---

<SiteLayout title={buildPageTitle(definition.data.name)} description={definition.data.description}>
  <article class="page-shell">
    <header class="page-header rise" style="--d: 0ms">
      <h1 id="page-title" translate="no">
        {definition.data.name}<span class="period" aria-hidden="true">.</span>
      </h1>
      <p class="page-description">{definition.data.description}</p>
      <div class="detail-actions">
        {promptBody && (
          <CopyPromptButton
            text={promptBody}
            ariaLabel={`Copy ${definition.data.name} prompt to clipboard`}
          />
        )}
        <a
          class="text-link"
          href={buildPromptSourceUrl(PROMPTS_REPOSITORY, definition.id)}
          target="_blank"
          rel="noopener noreferrer"
        >
          view source<span class="arrow-ext" aria-hidden="true">&nbsp;↗</span>
        </a>
      </div>
    </header>

    <section
      class="detail-section rise"
      style="--d: 80ms"
      aria-labelledby="prompt-content-title"
    >
      <div class="section-header">
        <h2 id="prompt-content-title" class="eyebrow">prompt.md</h2>
      </div>
      <div class="prose">
        <Content />
      </div>
    </section>
  </article>
</SiteLayout>
