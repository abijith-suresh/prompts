---
import { readFile } from "node:fs/promises";
import path from "node:path";
import { getCollection, getEntry, render } from "astro:content";

import CopyTextBlock from "../components/CopyTextBlock.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { extractPromptBody } from "../lib/extract-prompt-body";

export async function getStaticPaths() {
  const definitions = await getCollection("promptDefinitions");
  return definitions.map((definition) => ({
    params: { prompt: definition.id },
  }));
}

const slug = Astro.params.prompt;
if (!slug) {
  throw new Error("Prompt route parameter is required");
}

const definition = await getEntry("promptDefinitions", slug);
if (!definition) {
  throw new Error(`Prompt definition not found: ${slug}`);
}

const promptFilePath = path.join(process.cwd(), "prompts", slug, "PROMPT.md");
const promptMarkdown = await readFile(promptFilePath, "utf-8");
const promptBody = extractPromptBody(promptMarkdown);

const { Content } = await render(definition);
---

<SiteLayout title={`${definition.data.name} | Prompts`} description={definition.data.description}>
  <article class="page-shell">
    <nav class="breadcrumb eyebrow" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL}>Prompts</a>
      <span aria-hidden="true">/</span>
      <span translate="no">
        {definition.data.name}
      </span>
    </nav>

    <h1 translate="no">{definition.data.name}</h1>

    <section class="detail-section">
      <div class="section-header">
        <h2 class="eyebrow">Description</h2>
      </div>
      <p class="page-description">{definition.data.description}</p>
    </section>

    {promptBody && (
      <section class="detail-section">
        <div class="section-header">
          <h2 class="eyebrow">Copy prompt</h2>
        </div>
        <p class="page-description">Paste this into any AI chat application or coding agent.</p>
        <CopyTextBlock
          text={promptBody}
          ariaLabel={`Copy ${definition.data.name} prompt to clipboard`}
        />
      </section>
    )}

    <section class="detail-section">
      <div class="section-header">
        <h2 class="eyebrow">PROMPT.md</h2>
      </div>
      <div class="prose">
        <Content />
      </div>
    </section>
  </article>
</SiteLayout>
