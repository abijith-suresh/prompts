---
import { getCollection, getEntry, render } from "astro:content";

import CopyPromptButton from "@/components/CopyPromptButton.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import PageShell from "@/components/ui/PageShell.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { buildPageTitle } from "@/lib/route-metadata";
import { buildPromptSourceUrl, PROMPTS_REPOSITORY } from "@/lib/prompt-catalog";
import { extractPromptBody } from "@/lib/extract-prompt-body";

export async function getStaticPaths() {
  const definitions = await getCollection("promptDefinitions");
  return definitions.map((definition) => ({
    params: { prompt: definition.id },
  }));
}

const slug = Astro.params.prompt;
if (!slug) {
  throw new Error("Prompt route parameter is required");
}

const definition = await getEntry("promptDefinitions", slug);
if (!definition) {
  throw new Error(`Prompt definition not found: ${slug}`);
}

const promptBody = definition.body ? extractPromptBody(definition.body) : null;
const { Content } = await render(definition);
---

<SiteLayout title={buildPageTitle(definition.data.name)} description={definition.data.description}>
  <article>
    <PageShell>
      <Fragment slot="header">
        <PageHeader title={definition.data.name} subtitle={definition.data.description} />
        <div class="detail-actions rise" style="--d: 80ms">
          {promptBody && (
            <CopyPromptButton
              text={promptBody}
              ariaLabel={`Copy ${definition.data.name} prompt to clipboard`}
            />
          )}
          <a
            class="text-link"
            href={buildPromptSourceUrl(PROMPTS_REPOSITORY, definition.id)}
            target="_blank"
            rel="noopener noreferrer"
          >
            view source <span class="ext-arrow" aria-hidden="true">&nearr;</span>
          </a>
        </div>
      </Fragment>

      <section class="detail-section rise" style="--d: 80ms">
        <div class="section-header">
          <h2 class="eyebrow">prompt.md</h2>
        </div>
        <div class="prose">
          <Content />
        </div>
      </section>
    </PageShell>
  </article>
</SiteLayout>
