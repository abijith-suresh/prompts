---
import { buildPageTitle } from "../consts";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title={buildPageTitle("page not found")} description="Page not found" noindex>
  <div class="page-404">
    <div class="page-404-inner">
      <h1 class="hero-title rise" style="--d: 0ms">
        page not found<span class="period" aria-hidden="true">.</span>
      </h1>
      <p class="page-404-note rise" style="--d: 60ms">
        the page you're looking for doesn't exist or has been moved.
      </p>
      <a class="back-link rise" style="--d: 120ms" href={import.meta.env.BASE_URL}>
        <span class="arrow" aria-hidden="true">&larr;</span> back to prompts
      </a>
    </div>
  </div>
</SiteLayout>

<style>
  .page-404 {
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
  }

  .page-404-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-2xs);
    /* symmetric so the centered stack doesn't lean; doubles as breathing
       room on viewports too small to center into */
    padding-block: var(--space-2xl);
    margin-inline: auto;
    width: min(100%, var(--container));
    padding-inline: var(--page-inline);
  }

  .page-404 h1 {
    font-weight: 650;
    letter-spacing: var(--letter-spacing-heading);
  }

  .page-404-note {
    max-width: 32rem;
    margin-top: var(--space-2xs);
    color: var(--color-muted-foreground);
  }

  .back-link {
    margin-top: var(--space-s);
    font-size: var(--text-sm);
  }
</style>
