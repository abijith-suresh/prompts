---
import { getCollection } from "astro:content";
import PageHero from "../components/PageHero.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { buildPromptSummaries, PROMPTS_REPOSITORY } from "../lib/prompt-catalog";
import { buildPromptPath } from "../lib/site-paths";

const definitions = await getCollection("promptDefinitions");
const prompts = buildPromptSummaries(definitions, PROMPTS_REPOSITORY);
---

<SiteLayout
  title="Prompts"
  description="Browse personal AI prompts for coding agents and chat applications. Copy what you need."
>
  <section class="page-shell" aria-labelledby="page-title">
    <PageHero
      eyebrow="abijith-suresh/prompts"
      title="Prompts"
      description="Reusable prompts for AI coding agents and chat apps. Copy, paste, run."
    />

    <div class="section-header">
      <h2 class="eyebrow">Prompts</h2>
    </div>

    <ul class="content-list">
      {prompts.map((prompt) => (
        <li>
          <a href={buildPromptPath(import.meta.env.BASE_URL, prompt.slug)} class="ledger-row">
            <span class="ledger-row-title" translate="no">{prompt.name}</span>
            <span class="ledger-row-description">{prompt.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
