{
  "name": "prompts-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.14.1",
    "bun": ">=1.3.14"
  },
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro check && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test && bun run build"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.0",
    "astro": "^6.4.6",
    "satteri-expressive-code": "^0.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
